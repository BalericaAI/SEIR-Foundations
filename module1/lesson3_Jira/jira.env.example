# Copy these values into /opt/balerica-bank/.env (or the project .env).
# NEVER commit the real .env or share the token with Claude Code.
JIRA_SITE_URL=https://YOUR-SITE.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=REPLACE_WITH_PRIVATE_ATLASSIAN_API_TOKEN
JIRA_PROJECT_KEY=BAI
JIRA_ISSUE_TYPE=Task
JIRA_ENABLED=true
